# ==========================================
# Java & Build Tools
# ==========================================
# Compiled class files
*.class
*.log
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files (Uncomment if you do not want to ship jars/wars in your repository)
# *.jar
# *.war
# *.nar
# *.ear
# *.zip
# *.tar.gz
# *.rar

# Crash logs
hs_err_pid*
replay_pid*

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.next
pom.xml.note
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# Avoid ignoring Maven Wrapper jar if you use it
!.mvn/wrapper/maven-wrapper.jar

# Gradle
.gradle
/build/
!/src/main/**/build/
!/src/test/**/build/

# ==========================================
# Eclipse IDE
# ==========================================
.metadata
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.loadpath
.recommenders

# External tool builders
.externalToolBuilders/

# Locally stored "Eclipse launch configurations"
*.launch

# Eclipse build settings and classpath
.settings/
.project
.classpath
.factorypath

# ==========================================
# Visual Studio Code (VS Code)
# ==========================================
.vscode/
# If you are using the Red Hat Java extension, it creates Eclipse-like metadata hidden files
.apt_generated
.springBeans
.sts4-cache

# ==========================================
